<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="pp_comm_buffer" size="0x1_000" />
    <memory_region name="net_bufs" size="0x12_000" />
    <memory_region name="guest_ram" size="0x1000_0000" page_size="0x200_000" phys_addr="0x4000_0000" />
    <memory_region name="gic_vcpu" size="0x1_000" phys_addr="0x804_0000" />
    <memory_region name="uart" size="0x1_000" phys_addr="0x900_0000" />

    <protection_domain name="ping_pong" priority="101">
        <program_image path="ping_pong_component.elf" />
        <map mr="pp_comm_buffer" vaddr="0x2_000_000" perms="rw" cached="true"
            setvar_vaddr="pp_comm_buffer" />
    </protection_domain>

    <protection_domain name="vmm" priority="254">
        <program_image path="vmm.elf" />
        <map mr="guest_ram" vaddr="0x4000_0000" perms="rw"
            setvar_vaddr="guest_ram_vaddr" />
        <map mr="pp_comm_buffer" vaddr="0x5000_0000" perms="rw" cached="true"
            setvar_vaddr="pp_comm_buffer" />
        <map mr="net_bufs" vaddr="0x5200_0000" perms="rw" cached="true"
            setvar_vaddr="net" />
        <virtual_machine name="linux" priority="100">
            <vcpu id="0" />
            <map mr="guest_ram" vaddr="0x4000_0000" perms="rwx" />
            <map mr="uart" vaddr="0x900_0000" perms="rw" cached="false" />
            <map mr="gic_vcpu" vaddr="0x801_0000" perms="rw" cached="false" />
            <map mr="pp_comm_buffer" vaddr="0x5000_0000" perms="rw" cached="true" />
        </virtual_machine>
    </protection_domain>

    <channel>
        <end pd="vmm" id="1" />
        <end pd="ping_pong" id="1" />
    </channel>
</system>
